# Server-side secrets. Copy to .env.local for local dev. None of these are
# VITE_-prefixed, so none are compiled into the browser bundle.

# ——— Website (Vercel → Settings → Environment Variables) ———
# The /px/enso and /px/etherscan routes (api/px.ts in production, the same
# handler as Vite middleware in dev) attach these.

# Enso API key — quotes Ink pairs. https://developers.enso.build
# (The bot server needs it too, for Ink alerts.)
ENSO_KEY=

# Etherscan v2 API key — enumerates Uniswap v4 positions on Monad (Portfolio).
ETHERSCAN_KEY=

# ——— Bot server (fly secrets set …; see server/README.md) ———

# Telegram bot token from @BotFather. Only the bot server holds it.
TG_BOT_TOKEN=

# Your Telegram chat id. Leave empty at first: message the bot and it replies
# with your id. The bot answers no one else.
TG_OWNER_CHAT_ID=

# Long random string the website uses to read and change the bot's settings.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Set to 0 on a local copy while the hosted bot is running — Telegram lets only
# one process poll a bot token at a time.
# TG_POLL=0

# Local dev only: point the website's /px/bot at a bot server on this machine
# instead of the hosted one.
# BOT_URL=http://localhost:8080
