# Copy to .env.local for local dev, or set these in the Vercel project settings.
#
# WARNING: every VITE_* variable is compiled into the public JavaScript bundle.
# On a public deployment anyone can read these values from the browser.

# Enso API key — used to quote Ink pairs. https://developers.enso.build
VITE_ENSO_KEY=

# Etherscan v2 API key — enumerates Uniswap v4 positions on Monad (Portfolio tab).
VITE_ETHERSCAN_KEY=

# Telegram bot token from @BotFather — powers alert delivery.
# Whoever holds this token fully controls the bot.
VITE_TG_BOT_TOKEN=
