# Server-side secrets. Copy to .env.local for local dev, or set them in the
# Vercel project settings (Settings → Environment Variables).
#
# None of these are VITE_-prefixed, so none are compiled into the browser
# bundle: the /px/enso, /px/etherscan and /px/tg routes (api/px.ts in
# production, the same handler as Vite middleware in dev) attach them.

# Enso API key — quotes Ink pairs. https://developers.enso.build
ENSO_KEY=

# Etherscan v2 API key — enumerates Uniswap v4 positions on Monad (Portfolio).
ETHERSCAN_KEY=

# Telegram bot token from @BotFather — alert delivery. The server only lets the
# browser call getMe, sendMessage and a per-profile filtered getUpdates.
TG_BOT_TOKEN=
